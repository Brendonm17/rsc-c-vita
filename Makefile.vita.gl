# PlayStation Vita target, hardware renderer (RENDER_GL via vitaGL)
#
# Build:  ./build-vita-gl.sh
# Output: rsc-c-vita.vpk (same TITLE_ID as the software build, same install slot)
#
# needs libshacccg.suprx on the device (ur0:/data/) for runtime shader translation
# objects compile to .glo so this build coexists with the Makefile.vita objects
# png decode uses libpng (vita_img_load_png), SDL2_image is not in the VitaSDK

TARGET     := rsc-c-vita
TITLE_ID   := RSCC00001
TITLE_NAME := RuneScape

ifeq ($(strip $(VITASDK)),)
$(error VITASDK is not set. Install VitaSDK and run build-vita-gl.sh, or: export VITASDK=/usr/local/vitasdk)
endif

PREFIX  := arm-vita-eabi
CC      := $(PREFIX)-gcc
PKGCONF := $(PREFIX)-pkg-config

# gl renderer sources, cglm supplies the matrix math
SRC := $(wildcard src/*.c src/lib/*.c src/lib/rsa/*.c src/ui/*.c src/custom/*.c \
                  src/gl/*.c src/gl/textures/*.c)
OBJ := $(SRC:.c=.glo)

# single player embeds the offline rsc-server inside quickjs
SINGLEPLAYER ?= 1
ifeq ($(SINGLEPLAYER),1)
QJS_SRC    := $(wildcard src/quickjs/*.c)
QJS_OBJ    := $(QJS_SRC:.c=.o)
SP_CFLAGS  := -DWITH_SINGLEPLAYER -D_GNU_SOURCE -Isrc/quickjs
# -DNDEBUG matches the release CFLAGS: without it QuickJS's JS_FreeRuntime
# leak tripwire abort()s the app when a world with a live JS heap ends
QJS_CFLAGS := -std=gnu11 -fwrapv -O2 -DNDEBUG -D_GNU_SOURCE -Isrc/quickjs -w
SP_LIBS    := -lpthread
SP_VPK_ADD := --add sp/sp-bootstrap.js=sp/sp-bootstrap.js \
              --add sp/browser.bundle.js=sp/browser.bundle.js \
              --add sp/browser.bundle.bc=sp/browser.bundle.bc \
              --add sp/pathfinder.cache=sp/pathfinder.cache \
              --add sp/landscape.cache=sp/landscape.cache
endif

# NDEBUG: asserts off, packet over-read guards recover instead of aborting
CFLAGS  := -std=gnu99 -fwrapv -O2 -ffast-math -Wall -DNDEBUG \
           -DSDL2 -DRENDER_GL -I ./cglm/include $(SP_CFLAGS) \
           $(RSC_DIAG_CFLAGS) \
           $(shell $(PKGCONF) --cflags sdl2)

LDFLAGS := -Wl,-q -Wl,--undefined=_newlib_heap_size_user -Wl,--undefined=sceUserMainThreadStackSize

# --start-group resolves the circular deps between SDL2, vitaGL and the stubs
LIBS    := -Wl,--start-group \
           $(shell $(PKGCONF) --libs sdl2) \
           -lvitaGL -lvitashark -lSceShaccCg_stub -lSceShaccCgExt -ltaihen_stub \
           -lmathneon -lpng16 -lz \
           -lSceNet_stub -lSceNetCtl_stub -lSceSysmodule_stub \
           -lScePspnetAdhoc_stub \
           -lSceCommonDialog_stub -lSceGxm_stub -lSceDisplay_stub \
           -lSceAppMgr_stub -lSceCtrl_stub -lSceTouch_stub \
           -lSceKernelDmacMgr_stub -lSceKernelModulemgr_stub \
           -lstdc++ -lm $(SP_LIBS) \
           -Wl,--end-group

CACHE_FILES := $(shell find cache -type f)
VPK_ADD     := $(foreach f,$(CACHE_FILES),--add $(f)=$(f))
VPK_ADD     += $(SP_VPK_ADD)

ifneq ($(wildcard sce_sys/icon0.png),)
VPK_ADD += --add sce_sys/icon0.png=sce_sys/icon0.png
endif
ifneq ($(wildcard sce_sys/livearea/contents/template.xml),)
VPK_ADD += --add sce_sys/livearea/contents/bg0.png=sce_sys/livearea/contents/bg0.png
VPK_ADD += --add sce_sys/livearea/contents/startup.png=sce_sys/livearea/contents/startup.png
VPK_ADD += --add sce_sys/livearea/contents/template.xml=sce_sys/livearea/contents/template.xml
endif

all: $(TARGET).vpk

$(TARGET).vpk: eboot.bin param.sfo
	vita-pack-vpk -s param.sfo -b eboot.bin $(VPK_ADD) $@

eboot.bin: $(TARGET).velf
	vita-make-fself -s $< $@

param.sfo:
	vita-mksfoex -s TITLE_ID="$(TITLE_ID)" "$(TITLE_NAME)" $@

$(TARGET).velf: $(TARGET).elf
	vita-elf-create $< $@

$(TARGET).elf: $(OBJ) $(QJS_OBJ)
	$(CC) $(LDFLAGS) $(CFLAGS) $^ $(LIBS) -o $@

src/quickjs/%.o: src/quickjs/%.c
	$(CC) $(QJS_CFLAGS) -c $< -o $@

# c11 atomics for the single-player lock-free rings
src/mudclient-singleplayer.glo: src/mudclient-singleplayer.c
	$(CC) $(CFLAGS) -std=gnu11 -c $< -o $@

%.glo: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ) $(QJS_OBJ) $(TARGET).elf $(TARGET).velf eboot.bin param.sfo $(TARGET).vpk

.PHONY: all clean
