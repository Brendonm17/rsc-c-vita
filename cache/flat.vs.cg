// flat 2d/ui vertex shader (cg, psp2, precompiled to gxp via psp2cgc)
// Inputs are declared in rsc-c's attribute order (location 0..3) so vitaGL's
// default attribute bindings line up with glVertexAttribPointer(0..3).
void main(
    float3 position,
    float4 colour,
    float2 texture_position,
    float2 base_texture_position,
    float4 out vertex_colour : TEXCOORD0,
    float2 out vertex_texture_position : TEXCOORD1,
    float2 out vertex_base_texture_position : TEXCOORD2,
    float4 out gl_Position : POSITION)
{
    gl_Position = float4(position, 1.0f);
    vertex_colour = colour;
    vertex_texture_position = texture_position;
    vertex_base_texture_position = base_texture_position;
}
