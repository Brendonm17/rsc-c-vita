// flat 2d/ui fragment shader (cg, psp2)
// Sampler names match rsc-c's shader_set_int("sprite_texture",0)/(...,1); the
// TEXUNIT semantics fix them to GL texture units 0 and 1.
uniform sampler2D sprite_texture : TEXUNIT0;
uniform sampler2D sprite_base_texture : TEXUNIT1;

float4 main(
    float4 vertex_colour : TEXCOORD0,
    float2 vertex_texture_position : TEXCOORD1,
    float2 vertex_base_texture_position : TEXCOORD2)
{
    float4 texture_colour = tex2D(sprite_texture, vertex_texture_position);
    float4 base_texture_colour = tex2D(sprite_base_texture, vertex_base_texture_position);

    float4 fragment_colour = (texture_colour * vertex_colour) + base_texture_colour;

    // GLSL "if (w <= 0.0) discard;"
    clip(fragment_colour.w - 0.00001f);

    return fragment_colour;
}
